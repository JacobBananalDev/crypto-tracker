# ------------------------------------------------------------
# Frontend Dockerfile
#
# This container builds and runs the Next.js application.
# ------------------------------------------------------------

# Use Node runtime
FROM node:20

# Set working directory
WORKDIR /app

# Copy dependency files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy project files
COPY . .

# Build Next.js app
RUN npm run build

# Expose frontend port
EXPOSE 3000

# Start production server
CMD ["npm", "start"]